<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/control_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#CC000000"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/tv_network_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="网络: WiFi"
                android:textColor="#43A047"
                android:textSize="14sp"
                android:background="#40000000"
                android:padding="6dp" />

            <TextView
                android:id="@+id/tv_config_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="配置: http://192.168.x.x:8765"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:background="#40000000"
                android:padding="6dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_source_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="央视新闻直播"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btn_prev_source"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/tv_button_selector"
                android:src="@android:drawable/arrow_up_float"
                android:contentDescription="上一个源"
                android:scaleType="centerInside"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="16dp" />

            <ImageButton
                android:id="@+id/btn_next_source"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/tv_button_selector"
                android:src="@android:drawable/arrow_down_float"
                android:contentDescription="下一个源"
                android:scaleType="centerInside"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="16dp" />

            <ImageButton
                android:id="@+id/btn_prev_mode"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/tv_button_selector"
                android:src="@android:drawable/ic_media_previous"
                android:contentDescription="切换模式(左)"
                android:scaleType="centerInside"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="16dp" />

            <ImageButton
                android:id="@+id/btn_next_mode"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/tv_button_selector"
                android:src="@android:drawable/ic_media_next"
                android:contentDescription="切换模式(右)"
                android:scaleType="centerInside"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="16dp" />

            <ImageButton
                android:id="@+id/btn_switch_mode"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/tv_button_selector"
                android:src="@android:drawable/ic_menu_view"
                android:contentDescription="切换模式"
                android:scaleType="centerInside"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="16dp" />

            <ImageButton
                android:id="@+id/btn_orientation"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/tv_button_selector"
                android:src="@android:drawable/ic_menu_rotate"
                android:contentDescription="切换横竖屏"
                android:scaleType="centerInside"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="16dp" />

            <ImageButton
                android:id="@+id/btn_lock_orientation"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/tv_button_selector"
                android:src="@android:drawable/ic_lock_lock"
                android:contentDescription="锁定方向"
                android:scaleType="centerInside"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="16dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_hint_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="方向键选择网页元素 | 频道+/-切换网站 | 菜单键打开配置 | 返回键退出/返回 | 确认键点击"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:gravity="center" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- 右上角信息面板：农历/节气/时间/地点/天气 -->
    <LinearLayout
        android:id="@+id/info_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:orientation="vertical"
        android:gravity="end"
        android:background="#8C000000"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clickable="false"
        android:focusable="false">

        <!-- 第一行：农历 + 节气胶囊 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_lunar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="丙午年 五月廿九"
                android:textColor="#FFD54F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2" />

            <TextView
                android:id="@+id/tv_jieqi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="距处暑 15天"
                android:textColor="#81D4FA"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp" />

        </LinearLayout>

        <!-- 第二行：公历日期 -->
        <TextView
            android:id="@+id/tv_solar_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="2026年08月08日 周五"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="end"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2" />

        <!-- 第三行：时间 -->
        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="14:30:25"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="end"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="4dp"
            android:background="#33FFFFFF" />

        <!-- 第四行：地点 + 天气三列并排 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 定位中..."
                android:textColor="#FFD54F"
                android:textSize="11sp"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 今天 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_w0_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="今天"
                        android:textColor="#B3FFFFFF"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tv_w0_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="☀️"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_w0_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--°/--°"
                        android:textColor="#81D4FA"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- 明天 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_w1_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="明天"
                        android:textColor="#B3FFFFFF"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tv_w1_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⛅"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_w1_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--°/--°"
                        android:textColor="#81D4FA"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- 后天 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_w2_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="后天"
                        android:textColor="#B3FFFFFF"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tv_w2_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌧️"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_w2_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--°/--°"
                        android:textColor="#81D4FA"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
