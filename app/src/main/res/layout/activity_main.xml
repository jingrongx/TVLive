<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/control_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#CC000000"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/tv_network_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="网络: WiFi"
                android:textColor="#43A047"
                android:textSize="14sp"
                android:background="#40000000"
                android:padding="6dp" />

            <TextView
                android:id="@+id/tv_config_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="配置: http://192.168.x.x:8765"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:background="#40000000"
                android:padding="6dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_source_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="央视新闻直播"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btn_prev_source"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/tv_button_selector"
                android:src="@android:drawable/arrow_up_float"
                android:contentDescription="上一个源"
                android:scaleType="centerInside"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="16dp" />

            <ImageButton
                android:id="@+id/btn_next_source"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/tv_button_selector"
                android:src="@android:drawable/arrow_down_float"
                android:contentDescription="下一个源"
                android:scaleType="centerInside"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="16dp" />

            <ImageButton
                android:id="@+id/btn_prev_mode"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/tv_button_selector"
                android:src="@android:drawable/ic_media_previous"
                android:contentDescription="切换模式(左)"
                android:scaleType="centerInside"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="16dp" />

            <ImageButton
                android:id="@+id/btn_next_mode"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/tv_button_selector"
                android:src="@android:drawable/ic_media_next"
                android:contentDescription="切换模式(右)"
                android:scaleType="centerInside"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="16dp" />

            <ImageButton
                android:id="@+id/btn_switch_mode"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/tv_button_selector"
                android:src="@android:drawable/ic_menu_view"
                android:contentDescription="切换模式"
                android:scaleType="centerInside"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="16dp" />

            <ImageButton
                android:id="@+id/btn_orientation"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/tv_button_selector"
                android:src="@android:drawable/ic_menu_rotate"
                android:contentDescription="切换横竖屏"
                android:scaleType="centerInside"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="16dp" />

            <ImageButton
                android:id="@+id/btn_lock_orientation"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/tv_button_selector"
                android:src="@android:drawable/ic_lock_lock"
                android:contentDescription="锁定方向"
                android:scaleType="centerInside"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="16dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_hint_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="方向键选择网页元素 | 频道+/-切换网站 | 菜单键打开配置 | 返回键退出/返回 | 确认键点击"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:gravity="center" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- 顶部信息横幅条：28dp 超窄，三栏铺开（农历/时辰/节气 | 日期时间 | 地点+天气） -->
    <LinearLayout
        android:id="@+id/info_overlay"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#A6000000"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:clickable="false"
        android:focusable="false">

        <!-- 左栏：农历 + 时辰 + 节气胶囊 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_lunar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="丙午年 六月廿六"
                android:textColor="#FFD600"
                android:textSize="13sp"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3" />

            <TextView
                android:id="@+id/tv_shichen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="未正二刻"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3" />

            <TextView
                android:id="@+id/tv_jieqi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="距处暑 15天"
                android:textColor="#FF6D00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:background="#26FF6D00"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2" />

        </LinearLayout>

        <!-- 中栏：公历日期时间（弹性占据中间空间，居中） -->
        <TextView
            android:id="@+id/tv_date_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="2026年08月08日 周五 14:30:25"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <!-- 右栏：地点 + 分隔线 + 天气三列 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 定位中..."
                android:textColor="#FFD600"
                android:textSize="13sp"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3" />

            <View
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="#4DFFFFFF" />

            <!-- 天气三列横排：今/明/后 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 今天 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_w0_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="今"
                        android:textColor="#D9FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:shadowColor="#000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="2" />

                    <TextView
                        android:id="@+id/tv_w0_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="☀️"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_w0_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="--°/--°"
                        android:textColor="#FF6D00"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:shadowColor="#000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="2" />

                </LinearLayout>

                <!-- 明天 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_w1_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="明"
                        android:textColor="#D9FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:shadowColor="#000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="2" />

                    <TextView
                        android:id="@+id/tv_w1_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="⛅"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_w1_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="--°/--°"
                        android:textColor="#FF6D00"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:shadowColor="#000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="2" />

                </LinearLayout>

                <!-- 后天 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_w2_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="后"
                        android:textColor="#D9FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:shadowColor="#000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="2" />

                    <TextView
                        android:id="@+id/tv_w2_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="🌧️"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_w2_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="--°/--°"
                        android:textColor="#FF6D00"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:shadowColor="#000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="2" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
